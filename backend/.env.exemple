# ─────────────────────────────────────────────────────────────
# BâtiPlus — .env du BACKEND (EXEMPLE, sans aucune vraie clé)
# Copier en « backend/.env » sur le serveur. JAMAIS versionné, JAMAIS dans l'application :
# les clés d'agrégateur n'existent QUE dans ce fichier.
# Le backend refuse de démarrer si une valeur obligatoire manque ou est faible.
# ─────────────────────────────────────────────────────────────

# Environnement : production | developpement
NODE_ENV=production
PORT=8080
HOTE=0.0.0.0
# 1 si le backend est derrière un proxy (Nginx, Caddy) qui ajoute X-Forwarded-For
CONFIANCE_PROXY=1

# Adresse publique de l'API (https obligatoire en production) — sert aux URL de notification et de retour
URL_PUBLIQUE=https://api.votredomaine.com
# Site web (partie 3) : le retour de paiement y renvoie vers /#paiement-retour?ref=… (facultatif)
URL_SITE=
# Origines autorisées (CORS), séparées par des virgules — jamais « * ».
# https://localhost = l'application Android (Capacitor) ; capacitor://localhost = iOS (voir IOS.md)
ORIGINES_AUTORISEES=https://localhost,capacitor://localhost,https://votredomaine.com

# Base SQLite (WAL) — dossier hors du dépôt, sauvegardé chaque nuit
BASE_DONNEES=donnees/batiplus.sqlite

# Secrets — générer chacun avec : openssl rand -hex 32 (trois valeurs DIFFÉRENTES)
# Une valeur d'exemple, répétitive ou identique à une autre est refusée au démarrage.
JETON_SECRET=
WEBHOOK_SECRET=

# ── Administration (étape 14) ──
# Code administrateur HACHÉ (scrypt) — jamais le code en clair, ni ici, ni dans l'application :
#   node outils/hacher-code-admin.mjs     (saisie masquée, copie la ligne affichée ici)
ADMIN_CODE_HASH=
# Facultatif : adresses IP autorisées pour /api/admin (séparées par des virgules). Vide = toutes,
# avec blocage d'une heure après 3 codes faux depuis une même adresse.
ADMIN_IPS=

# ── Sauvegarde quotidienne chiffrée (AES-256-GCM) ──
# Clé de 64 caractères hexadécimaux : openssl rand -hex 32 (différente des secrets ci-dessus).
# À conserver AUSSI hors du serveur (coffre, papier) : sans elle, les sauvegardes sont illisibles.
SAUVEGARDE_CLE=
# Dossier des sauvegardes (relatif au dossier backend/), 30 jours gardés
SAUVEGARDE_DOSSIER=sauvegardes

# Clé PRIVÉE de signature des abonnements (ECDSA P-256), créée par :
#   node src/scripts/cles-abonnement.mjs generer   (depuis le dossier batiplus/)
# La clé publique correspondante va dans le .env de l'application (ABONNEMENT_CLE_PUBLIQUE).
ABONNEMENT_CLE_PRIVEE_CHEMIN=../.cles/abonnement-privee.pem

# ── Paiement ──
# Agrégateur principal et de secours : ligdicash | cinetpay | fedapay | paydunya | stripe | simulation
PAIEMENT_FOURNISSEUR=ligdicash
PAIEMENT_SECOURS=cinetpay
# test = bac à sable de l'agrégateur ; production = vrais paiements (exige NODE_ENV=production)
PAIEMENT_MODE=test

# LigdiCash (https://ligdicash.com — espace marchand → API)
LIGDICASH_API_KEY=
LIGDICASH_AUTH_TOKEN=

# CinetPay (https://cinetpay.com — un couple par pays : celui du Burkina Faso)
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=

# FedaPay (clé secrète sk_… et secret du webhook wh_…)
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# PayDunya
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# Stripe (cartes ; seul agrégateur du renouvellement automatique par carte)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Simulation (développement uniquement — interdite en production)
SIMULATION_SECRET=
