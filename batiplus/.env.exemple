# ─────────────────────────────────────────────────────────────
# BâtiPlus — variables de configuration (EXEMPLE, sans aucune vraie clé)
# Copier ce fichier en « .env » et remplir les valeurs.
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).
# Aucune de ces valeurs secrètes ne doit apparaître dans www/ :
# le front ne connaît que l'adresse publique de l'API.
# ─────────────────────────────────────────────────────────────

# Adresse publique du serveur (seule valeur connue du front)
API_URL=https://api.batiplus.bf

# Clé PUBLIQUE de vérification des jetons d'abonnement (étape 11), SPKI en base64.
# Générer la paire avec : node src/scripts/cles-abonnement.mjs generer
# La clé PRIVÉE (signature) reste hors du dépôt et n'est jamais dans le front.
ABONNEMENT_CLE_PUBLIQUE=
# Chemin de la clé privée de signature (backend, étape 14)
ABONNEMENT_CLE_PRIVEE_CHEMIN=.cles/abonnement-privee.pem

# Environnement : production | developpement
NODE_ENV=production

# Agrégateur de paiement actif : simulation | cinetpay | ligdicash | fedapay | paydunya | stripe
PAIEMENT_FOURNISSEUR=simulation

# Secrets serveur (étape 14) — générer avec : openssl rand -hex 32
JETON_SECRET=
WEBHOOK_SECRET=
ADMIN_CODE_HACHE=

# Clés de l'agrégateur (étape 12) — fournies par l'agrégateur, jamais dans le front
AGREGATEUR_CLE_API=
AGREGATEUR_ID_SITE=
AGREGATEUR_CLE_SECRETE=

# Signature Android (étape 13) — le fichier .keystore reste HORS du dépôt
ANDROID_KEYSTORE_CHEMIN=
ANDROID_KEYSTORE_ALIAS=batiplus
ANDROID_KEYSTORE_MOT_DE_PASSE=
