<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS obligatoire partout : aucun échange en clair, certificats système uniquement
     (les certificats ajoutés par l'utilisateur ne sont pas acceptés). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
